{
  "sections": {
    "main": {
      "type": "main-article",
      "settings": {},
      "blocks": {
        "featured_image": {
          "type": "featured_image",
          "settings": {
            "image_height": "large"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "blog_show_date": true,
            "blog_show_author": false
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "content": {
          "type": "content",
          "settings": {}
        }
      },
      "block_order": [
        "featured_image",
        "title",
        "share",
        "content"
      ]
