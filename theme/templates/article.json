    "newsletter": {
      "type": "newsletter",
      "settings": {
        "color_scheme": "scheme-2",
        "full_width": true,
        "padding_top": 68,
        "padding_bottom": 52,
        "visibility": "all",
        "custom_colors": false
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
