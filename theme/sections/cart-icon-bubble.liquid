{% if settings.cart_icon != blank and settings.cart_icon != 'bag-1' %}
  {%- assign gad_cart_svg = 'icon-gad-' | append: settings.cart_icon | append: '.svg' -%}
  <span class="svg-wrapper">{{ gad_cart_svg | inline_asset_content }}</span>
{% elsif cart == empty %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  {%- capture gad_count -%}{% render 'gad-cart-count' %}{%- endcapture -%}
  {%- assign gad_count = gad_count | plus: 0 -%}
  <div class="cart-count-bubble">
    {%- if gad_count < 100 -%}
      <span aria-hidden="true">{{ gad_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: gad_count }}</span>
  </div>
{%- endif -%}
