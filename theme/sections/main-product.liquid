        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "placeholder": "Agregar al carrito"
        },
        {
          "type": "checkbox",
          "id": "custom_button",
          "label": "Color propio del botón",
          "default": false
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Fondo del botón",
          "default": "#121212",
