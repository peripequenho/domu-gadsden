          "label": "Título",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "d_stars",
          "label": "Estrellas",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "d_price",
          "label": "Precio",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "d_badge",
          "label": "Etiqueta de oferta",
          "default": true
        },
        {
          "type": "checkbox",
