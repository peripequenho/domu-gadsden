{%- render 'cart-drawer', section: section -%}

{% schema %}
{
  "name": "Carrito lateral",
  "class": "gad-cart-drawer-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Para que el carrito sea lateral, en Configuración del tema > Carrito elegí el tipo \"Cajón\". La combinación de colores del cajón también está ahí."
    },
    {
      "type": "checkbox",
      "id": "test_mode",
      "label": "Modo prueba",
      "default": false,
      "info": "Deja el cajón abierto en el editor para personalizarlo. No cambia nada en la tienda."
    },
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Título",
      "default": "Tu carrito ({cantidad})",
      "info": "{cantidad}: los productos del carrito, sin contar los sumados como extra ni los regalos. Vacío: \"Tu carrito\"."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Ancho"
    },
    {
      "type": "select",
      "id": "width_d",
      "label": "Ancho en desktop",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "wide",
          "label": "Ancho"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "width_m",
      "label": "Ancho en mobile",
      "options": [
        {
          "value": "partial",
          "label": "Parcial"
        },
        {
          "value": "full",
          "label": "Pantalla completa"
        }
      ],
      "default": "partial"
    },
    {
      "type": "header",
      "content": "Fondos"
    },
    {
      "type": "checkbox",
      "id": "header_bg",
      "label": "Fondo propio en el encabezado",
      "default": false
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Color del encabezado",
      "default": "#F3F3F3"
    },
    {
      "type": "checkbox",
      "id": "body_bg",
      "label": "Fondo propio en el cuerpo",
      "default": false
    },
    {
      "type": "color",
      "id": "body_bg_color",
      "label": "Color del cuerpo",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "footer_bg",
      "label": "Fondo propio en el pie",
      "default": false
    },
    {
      "type": "color",
      "id": "footer_bg_color",
      "label": "Color del pie",
      "default": "#F3F3F3"
    },
    {
      "type": "header",
      "content": "Tamaño de la letra"
    },
    {
      "type": "select",
      "id": "title_scale",
      "label": "Tamaño de los títulos",
      "options": [
        {
          "value": "70",
          "label": "70 %"
        },
        {
          "value": "80",
          "label": "80 %"
        },
        {
          "value": "90",
          "label": "90 %"
        },
        {
          "value": "100",
          "label": "Normal"
        },
        {
          "value": "110",
          "label": "110 %"
        },
        {
          "value": "125",
          "label": "125 %"
        },
        {
          "value": "150",
          "label": "150 %"
        },
        {
          "value": "175",
          "label": "175 %"
        },
        {
          "value": "200",
          "label": "200 %"
        }
      ],
      "default": "100"
    },
    {
      "type": "select",
      "id": "text_scale",
      "label": "Tamaño de los textos",
      "options": [
        {
          "value": "70",
          "label": "70 %"
        },
        {
          "value": "80",
          "label": "80 %"
        },
        {
          "value": "90",
          "label": "90 %"
        },
        {
          "value": "100",
          "label": "Normal"
        },
        {
          "value": "110",
          "label": "110 %"
        },
        {
          "value": "125",
          "label": "125 %"
        },
        {
          "value": "150",
          "label": "150 %"
        },
        {
          "value": "175",
          "label": "175 %"
        },
        {
          "value": "200",
          "label": "200 %"
        }
      ],
      "default": "100",
      "info": "Agranda o achica los títulos y los textos de esta sección respecto del tamaño global."
    },
    {
      "type": "checkbox",
      "id": "money_no_cents",
      "label": "Ocultar los centavos cuando son cero",
      "default": false,
      "info": "En el ahorro de cada producto, el total ahorrado y lo que falta en la barra de progreso."
    }
  ],
  "blocks": [
    {
      "type": "items",
      "name": "Lista de productos",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Siempre va en el cuerpo. Dentro del cuerpo, respeta el orden de los bloques."
        },
        {
          "type": "header",
          "content": "Imagen y título"
        },
        {
          "type": "select",
          "id": "image_size",
          "label": "Tamaño de la imagen",
          "options": [
            {
              "value": "small",
              "label": "Chica"
            },
            {
              "value": "medium",
              "label": "Mediana"
            },
            {
              "value": "large",
              "label": "Grande"
            }
          ],
          "default": "medium"
        },
        {
          "type": "checkbox",
          "id": "image_link",
          "label": "La imagen lleva al producto",
          "default": true
        },
        {
          "type": "select",
          "id": "title_size",
          "label": "Tamaño del título",
          "options": [
            {
              "value": "small",
              "label": "Chico"
            },
            {
              "value": "medium",
              "label": "Mediano"
            },
            {
              "value": "large",
              "label": "Grande"
            }
          ],
          "default": "medium"
        },
        {
          "type": "checkbox",
          "id": "title_link",
          "label": "El título lleva al producto",
          "default": true
        },
        {
          "type": "select",
          "id": "variant_style",
          "label": "Variante",
          "options": [
            {
              "value": "classic",
              "label": "Clásica (Color: Negro, Talle: S)"
            },
            {
              "value": "compact",
              "label": "Compacta (Negro / S)"
            }
          ],
          "default": "classic"
        },
        {
          "type": "header",
          "content": "Precio"
        },
        {
          "type": "select",
          "id": "price_position",
          "label": "Ubicación del precio",
          "options": [
            {
              "value": "right",
              "label": "A la derecha"
            },
            {
              "value": "left",
              "label": "A la izquierda"
            }
          ],
          "default": "right",
          "info": "A la izquierda: el precio va debajo del título y la cantidad a la derecha."
        },
        {
          "type": "select",
          "id": "compare_source",
          "label": "Precio tachado",
          "options": [
            {
              "value": "auto",
              "label": "Automático (el mayor)"
            },
            {
              "value": "cart",
              "label": "Según los descuentos del carrito"
            },
            {
              "value": "compare",
              "label": "Según el precio de comparación"
            }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "price_color",
          "label": "Color del precio",
          "options": [
            {
              "value": "text",
              "label": "Texto"
            },
            {
              "value": "muted",
              "label": "Texto suave"
            },
            {
              "value": "accent",
              "label": "Acento"
            },
            {
              "value": "button",
              "label": "Botón"
            }
          ],
          "default": "text"
        },
        {
          "type": "select",
          "id": "compare_color",
          "label": "Color del precio tachado",
          "options": [
            {
              "value": "text",
              "label": "Texto"
            },
            {
              "value": "muted",
              "label": "Texto suave"
            },
            {
              "value": "accent",
              "label": "Acento"
            },
            {
              "value": "button",
              "label": "Botón"
            }
          ],
          "default": "muted"
        },
        {
          "type": "checkbox",
          "id": "unit_price",
          "label": "Mostrar el precio unitario con descuento",
          "default": true,
          "info": "Debajo del título, cuando el producto tiene un descuento."
        },
        {
          "type": "text",
          "id": "unit_label",
          "label": "Etiqueta del precio unitario",
          "info": "Opcional, ej. \"Por unidad:\"."
        },
        {
          "type": "checkbox",
          "id": "savings",
          "label": "Mostrar el ahorro de la línea",
          "default": false
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Texto del ahorro",
          "default": "Ahorrás {monto}",
          "info": "{monto}: lo que se ahorra en esa línea."
        },
        {
          "type": "select",
          "id": "savings_position",
          "label": "Ahorro de cada producto",
          "options": [
            {
              "value": "title",
              "label": "Debajo del nombre"
            },
            {
              "value": "price",
              "label": "Debajo del precio"
            }
          ],
          "default": "title",
          "visible_if": "{{ block.settings.savings }}"
        },
        {
          "type": "select",
          "id": "savings_color",
          "label": "Color del ahorro",
          "options": [
            {
              "value": "text",
              "label": "Texto"
            },
            {
              "value": "muted",
              "label": "Texto suave"
            },
            {
              "value": "accent",
              "label": "Acento"
            },
            {
              "value": "button",
              "label": "Botón"
            }
          ],
          "default": "accent"
        },
        {
          "type": "header",
          "content": "Selector de cantidad"
        },
        {
          "type": "checkbox",
          "id": "qty_custom",
          "label": "Estilo propio",
          "default": false,
          "info": "Si no, usa el estilo de los campos del tema."
        },
        {
          "type": "range",
          "id": "qty_font",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Tamaño de la letra",
          "default": 14
        },
        {
          "type": "range",
          "id": "qty_icon",
          "min": 8,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Tamaño de los íconos",
          "default": 12
        },
        {
          "type": "range",
          "id": "qty_padding",
          "min": 0,
          "max": 12,
          "step": 1,
          "unit": "px",
          "label": "Relleno",
          "default": 2
        },
        {
          "type": "range",
          "id": "qty_radius",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Redondeo",
          "default": 6
        },
        {
          "type": "range",
          "id": "qty_border",
          "min": 0,
          "max": 4,
          "step": 1,
          "unit": "px",
          "label": "Grosor del borde",
          "default": 1
        },
        {
          "type": "color",
          "id": "qty_border_color",
          "label": "Color del borde",
          "default": "#CCCCCC"
        },
        {
          "type": "color_scheme",
          "id": "qty_scheme",
          "label": "Combinación del contenedor",
          "default": "scheme-1"
        },
        {
          "type": "color_scheme",
          "id": "qty_btn_scheme",
          "label": "Combinación de los botones",
          "default": "scheme-1"
        },
        {
          "type": "range",
          "id": "qty_divider",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Opacidad de los separadores",
          "default": 0
        },
        {
          "type": "select",
          "id": "qty_btn_shape",
          "label": "Botones",
          "options": [
            {
              "value": "square",
              "label": "Comunes"
            },
            {
              "value": "rounded",
              "label": "Redondeados"
            },
            {
              "value": "outline",
              "label": "En contorno"
            }
          ],
          "default": "square"
        },
        {
          "type": "header",
          "content": "Quitar"
        },
        {
          "type": "select",
          "id": "remove_position",
          "label": "Botón para quitar",
          "options": [
            {
              "value": "beside",
              "label": "Al lado de la cantidad"
            },
            {
              "value": "top",
              "label": "Arriba a la derecha de la línea"
            }
          ],
          "default": "beside"
        },
        {
          "type": "header",
          "content": "Márgenes"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Arriba",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Abajo",
          "default": 0
        }
      ]
    },
    {
      "type": "progress",
      "name": "Barra de progreso",
      "settings": [
        {
          "type": "paragraph",
          "content": "Siempre va en el cuerpo. La barra sólo avisa: el beneficio (por ejemplo, el envío gratis) se configura aparte en Shopify."
        },
        {
          "type": "select",
          "id": "goal_type",
          "label": "Base de la meta",
          "options": [
            {
              "value": "subtotal",
              "label": "Subtotal"
            },
            {
              "value": "quantity",
              "label": "Cantidad de productos"
            }
          ],
          "default": "subtotal"
        },
        {
          "type": "number",
          "id": "goal",
          "label": "Meta",
          "default": 50000,
          "info": "En la moneda de la tienda, sin centavos, o en cantidad de productos según la base."
        },
        {
          "type": "text",
          "id": "message",
          "label": "Mensaje mientras falta",
          "default": "Te faltan {monto} para el envío gratis",
          "info": "{monto}: lo que falta para la meta."
        },
        {
          "type": "text",
          "id": "success_message",
          "label": "Mensaje al llegar",
          "default": "¡Tenés envío gratis!"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Ícono",
          "default": "local_shipping",
          "info": "Nombre en inglés de Material Symbols. Vacío: sin ícono."
        },
        {
          "type": "checkbox",
          "id": "icon_filled",
          "label": "Ícono relleno",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Ícono propio (imagen)"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Color de la barra",
          "options": [
            {
              "value": "text",
              "label": "Texto"
            },
            {
              "value": "muted",
              "label": "Texto suave"
            },
            {
              "value": "accent",
              "label": "Acento"
            },
            {
              "value": "button",
              "label": "Botón"
            }
          ],
          "default": "accent"
        },
        {
          "type": "header",
          "content": "Márgenes"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Arriba",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Abajo",
          "default": 12
        }
      ]
    },
    {
      "type": "milestones",
      "name": "Barra de hitos",
      "settings": [
        {
          "type": "paragraph",
          "content": "Como la barra de progreso, con hasta 3 metas en el mismo recorrido. Siempre va en el cuerpo."
        },
        {
          "type": "select",
          "id": "goal_type",
          "label": "Base de la meta",
          "options": [
            {
              "value": "subtotal",
              "label": "Subtotal"
            },
            {
              "value": "quantity",
              "label": "Cantidad de productos"
            }
          ],
          "default": "subtotal"
        },
        {
          "type": "text",
          "id": "message",
          "label": "Mensaje mientras falta",
          "default": "Te faltan {monto} para {premio}",
          "info": "{monto}: lo que falta para la próxima meta. {premio}: el premio de esa meta."
        },
        {
          "type": "text",
          "id": "success_message",
          "label": "Mensaje final",
          "default": "¡Desbloqueaste todos los premios!"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Color de la barra",
          "options": [
            {
              "value": "text",
              "label": "Texto"
            },
            {
              "value": "muted",
              "label": "Texto suave"
            },
            {
              "value": "accent",
              "label": "Acento"
            },
            {
              "value": "button",
              "label": "Botón"
            }
          ],
          "default": "accent"
        },
        {
          "type": "range",
          "id": "label_size_d",
          "min": 8,
          "max": 18,
          "step": 1,
          "unit": "px",
          "label": "Etiquetas en desktop",
          "default": 12
        },
        {
          "type": "range",
          "id": "label_size_m",
          "min": 8,
          "max": 16,
          "step": 1,
          "unit": "px",
          "label": "Etiquetas en mobile",
          "default": 10
        },
        {
          "type": "header",
          "content": "Meta 1"
        },
        {
          "type": "checkbox",
          "id": "g1_on",
          "label": "Activar",
          "default": true
        },
        {
          "type": "number",
          "id": "g1_amount",
          "label": "Meta",
          "default": 20000,
          "info": "En la moneda de la tienda, sin centavos, o en cantidad de productos según la base."
        },
        {
          "type": "text",
          "id": "g1_icon",
          "label": "Ícono",
          "default": "local_shipping"
        },
        {
          "type": "checkbox",
          "id": "g1_filled",
          "label": "Ícono relleno",
          "default": true
        },
        {
          "type": "text",
          "id": "g1_label",
          "label": "Etiqueta bajo el ícono",
          "default": "Envío gratis"
        },
        {
          "type": "text",
          "id": "g1_prize",
          "label": "Premio para el mensaje",
          "default": "el envío gratis",
          "info": "Reemplaza a {premio}."
        },
        {
          "type": "header",
          "content": "Meta 2"
        },
        {
          "type": "checkbox",
          "id": "g2_on",
          "label": "Activar",
          "default": true
        },
        {
          "type": "number",
          "id": "g2_amount",
          "label": "Meta",
          "default": 40000
        },
        {
          "type": "text",
          "id": "g2_icon",
          "label": "Ícono",
          "default": "percent"
        },
        {
          "type": "checkbox",
          "id": "g2_filled",
          "label": "Ícono relleno",
          "default": true
        },
        {
          "type": "text",
          "id": "g2_label",
          "label": "Etiqueta bajo el ícono",
          "default": "Descuento"
        },
        {
          "type": "text",
          "id": "g2_prize",
          "label": "Premio para el mensaje",
          "default": "tu descuento"
        },
        {
          "type": "header",
          "content": "Meta 3"
        },
        {
          "type": "checkbox",
          "id": "g3_on",
          "label": "Activar",
          "default": false
        },
        {
          "type": "number",
          "id": "g3_amount",
          "label": "Meta",
          "default": 60000
        },
        {
          "type": "text",
          "id": "g3_icon",
          "label": "Ícono",
          "default": "redeem"
        },
        {
          "type": "checkbox",
          "id": "g3_filled",
          "label": "Ícono relleno",
          "default": true
        },
        {
          "type": "text",
          "id": "g3_label",
          "label": "Etiqueta bajo el ícono",
          "default": "Regalo"
        },
        {
          "type": "text",
          "id": "g3_prize",
          "label": "Premio para el mensaje",
          "default": "tu regalo"
        },
        {
          "type": "header",
          "content": "Márgenes"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Arriba",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Abajo",
          "default": 12
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Cuenta regresiva",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Completá tu compra en {tiempo}",
          "info": "{tiempo}: minutos y segundos que bajan. Arranca la primera vez que se abre el cajón, vuelve a empezar al recargar la página y, al llegar a cero, sigue desde 1:30. No vence nada: es sólo un aviso."
        },
        {
          "type": "number",
          "id": "duration",
          "label": "Duración en segundos",
          "default": 300
        },
