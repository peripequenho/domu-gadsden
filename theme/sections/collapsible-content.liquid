{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign s = section.settings
  assign box_key = section.id | append: '-box'
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
{%- render 'gad-colors', s: s, key: box_key, prefix: 'container_' -%}
{%- capture box_scheme -%}{% render 'gad-scheme', s: s, key: box_key, prefix: 'container_' %}{%- endcapture -%}
<div class="{% render 'gad-scheme', s: s, key: section.id %}" {% render 'gad-section-attrs', s: s %}>
  <div class="collapsible-content collapsible-{{ section.settings.layout }}-layout isolate{% if section.settings.layout == 'section' %} page-width{% elsif section.settings.layout == 'none' %} content-container content-container--full-width{% endif %}">
    <div class="collapsible-content__wrapper section-{{ section.id }}-padding{% if section.settings.layout == 'section' %} content-container {{ box_scheme }}{% endif %}">
      <div class="{% if section.settings.image == blank %}collapsible-content-wrapper-narrow{% else %}page-width{% endif %}">
        <div
          class="collapsible-content__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="text-align: {{ section.settings.heading_alignment }};"
        >
          {%- if section.settings.caption != blank -%}
            <p class="gad-heading__caption caption-with-letter-spacing">
              {{ section.settings.caption | escape }}
            </p>
          {% endif %}
          {%- if section.settings.heading != blank -%}
            <h2
              class="collapsible-content__heading inline-richtext gad-hl {{ section.settings.heading_size }}"
              {% if s.heading_accent != blank %}
                style="--gad-hl: {{ s.heading_accent }};"
              {% endif %}
            >
              {{ section.settings.heading }}
            </h2>
          {%- else -%}
            <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
          {% endif %}
        </div>
        <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.image != blank or s.video != blank -%}
            <div class="grid__item collapsible-content__grid-item">
              <div
                class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings gradient"
                {% if section.settings.image_ratio == 'adapt' and s.video != blank %}
                  style="padding-bottom: {{ 1 | divided_by: s.video.aspect_ratio | times: 100 }}%;"
                {% elsif section.settings.image_ratio == 'adapt' %}
                  style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {%- if s.video != blank -%}
                  {%- render 'gad-video', video: s.video, poster: section.settings.image, autoplay: s.video_autoplay, loop: true, tap: true, cover: true -%}
                {%- else -%}
                {%- liquid
                  assign padding_multiplier = 1
                  if section.settings.layout == 'section'
                    assign padding_multiplier = 2
                  endif
                  assign desktop_tablet_padding = 100 | times: padding_multiplier | append: 'px'
                  assign mobile_padding = 30 | times: padding_multiplier | append: 'px'
                -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ desktop_tablet_padding }}) / 2),
                  (min-width: 750px) calc((100vw - {{ desktop_tablet_padding }}) / 2),
                  calc(100vw - {{ mobile_padding }})
                {%- endcapture -%}
                {{
                  section.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
                }}
                {%- endif -%}
              </div>
            </div>
          {% endif %}
          <div class="grid__item"{% if s.row_style == 'box' %} style="--acc-bw: {{ s.box_border }}px;{% if s.box_bg != blank %} --acc-bg: {{ s.box_bg }};{% endif %}{% if s.open_bg != blank %} --acc-open-bg: {{ s.open_bg }};{% endif %}{% if s.open_text != blank %} --acc-open-text: {{ s.open_text }};{% endif %}"{% endif %}>
            {%- for block in section.blocks -%}
              <div
                class="accordion gad-acc gad-acc--{{ s.title_size }} gad-acc--{{ s.toggle_icon }}{% if s.row_style == 'box' %} gad-acc--box{% endif %}{% unless s.top_border %} gad-acc--no-border{% endunless %}{% if section.settings.layout == 'row' %} content-container {{ box_scheme }}{% endif %}"
                {{ block.shopify_attributes }}
              >
                <details
                  id="Details-{{ block.id }}-{{ section.id }}"
                  {% if section.settings.open_first_collapsible_row and forloop.first %}
                    open
                  {% endif %}
                >
                  <summary id="Summary-{{ block.id }}-{{ section.id }}">
                    {%- assign row_icon = block.settings.icon_name | default: block.settings.icon -%}
                    {% render 'icon-accordion', icon: row_icon, filled: block.settings.icon_filled, image: block.settings.icon_image %}
                    <h3 class="accordion__title inline-richtext h4">
                      {{ block.settings.heading | default: block.settings.page.title | escape }}
                    </h3>
                    {%- if s.toggle_icon == 'plus' -%}
                      <span class="gad-acc__plus" aria-hidden="true"></span>
                    {%- else -%}
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    {%- endif -%}
                  </summary>
                  <div
                    class="accordion__content rte"
                    id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                    role="region"
                    aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                  >
                    {{ block.settings.row_content }}
                    {{ block.settings.page.content }}
                  </div>
                </details>
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if s.footer != blank -%}
          <div class="gad-acc__footer rte" style="text-align: {{ section.settings.heading_alignment }};">{{ s.footer }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

