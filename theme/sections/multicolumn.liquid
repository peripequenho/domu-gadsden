{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign gad_carousel = false
  if section.settings.d_carousel or section.settings.m_carousel
    assign gad_carousel = true
  endif
-%}

{%- liquid
  assign s = section.settings
  assign card_key = section.id | append: '-card'
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
{%- if s.card_style == 'custom' -%}
  {%- render 'gad-colors', s: s, key: card_key, prefix: 'card_', force: true -%}
{%- endif -%}
<div
  class="multicolumn gad-mc gad-mc--media-{{ s.media_position }} gad-mc--valign-{{ s.valign }}{% if s.equal_height %} gad-mc--equal{% endif %}{% if s.card_style != 'none' %} gad-mc--cards{% else %} background-none{% endif %} {% render 'gad-scheme', s: s, key: section.id %}{% if section.settings.title == blank %} no-heading{% endif %}"
  style="--mc-t-d: {{ s.title_size_d }}px; --mc-t-m: {{ s.title_size_m }}px; --mc-x-d: {{ s.text_size_d }}px; --mc-x-m: {{ s.text_size_m }}px; --mc-gap: {{ s.title_gap }}px; --mc-pad-d: {{ s.card_pad_d }}px; --mc-pad-m: {{ s.card_pad_m }}px; --mc-r: {{ s.card_radius }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div
    class="{% if s.full_width %}gad-full-width{% else %}page-width{% endif %} section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2
          class="title inline-richtext gad-hl {{ section.settings.heading_size }}"
          {% if section.settings.title_accent != blank %}
            style="--gad-hl: {{ section.settings.title_accent }};"
          {% endif %}
        >
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}
    {%- liquid
      assign item_tag = 'li'
      if gad_carousel
        assign item_tag = 'div'
      endif
    -%}
    {%- capture gad_items -%}
      {%- liquid
            assign highest_ratio = 0
            for block in section.blocks
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endfor
          -%}
          {%- for block in section.blocks -%}
            {%- assign empty_column = '' -%}
            {%- if block.settings.image == blank
              and block.settings.title == blank
              and block.settings.text == blank
              and block.settings.link_label == blank
            -%}
              {%- assign empty_column = ' multicolumn-list__item--empty' -%}
            {%- endif -%}
  
            <{{ item_tag }}
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="multicolumn-list__item{% unless gad_carousel %} grid__item{% endunless %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              <div class="multicolumn-card content-container{% if s.card_style != 'none' %} {% render 'gad-card-class', s: s, key: card_key %}{% endif %}">
                {%- if block.settings.video != blank -%}
                  <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' %} multicolumn-card-spacing{% endif %} gad-mc__video">
                    {%- render 'gad-video',
                      video: block.settings.video,
                      poster: block.settings.image,
                      autoplay: block.settings.video_autoplay,
                      loop: true,
                      tap: true,
                      sound: false,
                      width: 1000
                    -%}
                  </div>
                {%- elsif block.settings.image != blank -%}
                  {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                    {% assign spaced_image = true %}
                  {% endif %}
                  <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
                    <div
                      class="media media--transparent media--{{ section.settings.image_ratio }}"
                      {% if section.settings.image_ratio == 'adapt' %}
                        style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                      {% endif %}
                    >
                      {%- liquid
                        assign number_of_columns = section.settings.columns_desktop
                        assign number_of_columns_mobile = section.settings.columns_mobile
                        assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                        assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                        assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                        if section.settings.image_width == 'half'
                          assign image_width = 0.5
                        elsif section.settings.image_width == 'third'
                          assign image_width = 0.33
                        else
                          assign image_width = 1
                        endif
                      -%}
                      {% capture sizes %}
                        (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                        (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                        (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                        calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                      {% endcapture %}
                      {{
                        block.settings.image
                        | image_url: width: 3200
                        | image_tag:
                          widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                          sizes: sizes,
                          class: 'multicolumn-card__image'
                      }}
                    </div>
                  </div>
                {%- endif -%}
                <div class="multicolumn-card__info">
                  {%- if block.settings.title != blank -%}
                    <h3 class="inline-richtext">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.link_label != blank -%}
                    <a
                      class="link animate-arrow"
                      {% if block.settings.link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.link }}"
                      {% endif %}
                    >
                      {{- block.settings.link_label | escape -}}
                      <span class="svg-wrapper"
                        ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                      >
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </{{ item_tag }}>
          {%- endfor -%}
    {%- endcapture -%}
    {%- if gad_carousel -%}
      <div class="gad-multicolumn-carousel">
        {%- render 'gad-carousel',
          s: section.settings,
          key: section.id,
          slides: gad_items,
          d_per_view: section.settings.columns_desktop,
          m_per_view: columns_mobile_int,
          label: section.settings.title,
          class: 'multicolumn-list'
        -%}
      </div>
    {%- else -%}
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {{- gad_items -}}
      </ul>
    {%- endif -%}
    <div class="center gad-mc__buttons">
      {%- render 'gad-atc-button', label: s.atc_label, product: s.atc_product, skip_cart: s.atc_skip_cart -%}
      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color",
      "id": "title_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Marcá en negrita las palabras del título que querés resaltar. Vacío: el acento de la combinación de colores."
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_image.content"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.multicolumn.settings.button_label.default",
      "label": "t:sections.multicolumn.settings.button_label.label",
      "info": "t:sections.multicolumn.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "header",
      "content": "Tarjetas"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Estilo de las tarjetas",
      "options": [
        {
          "value": "none",
          "label": "Sin tarjeta"
        },
        {
          "value": "scheme",
          "label": "Combinación de la paleta"
        },
        {
          "value": "tint",
          "label": "Velo claro"
        },
        {
          "value": "custom",
          "label": "Colores propios"
        }
      ],
      "default": "none",
      "info": "Velo claro: un fondo apenas más oscuro que el de la sección."
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Combinación de las tarjetas",
      "default": "scheme-2",
      "info": "Sólo con \"Combinación de la paleta\"."
    },
    {
      "type": "color",
      "id": "card_cc_bg",
      "label": "Fondo de las tarjetas",
      "default": "#F3F3F3",
      "info": "Sólo con \"Colores propios\"."
    },
    {
      "type": "color_background",
      "id": "card_cc_bg_gradient",
      "label": "Degradé de las tarjetas"
    },
    {
      "type": "color",
      "id": "card_cc_text",
      "label": "Texto de las tarjetas",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Redondeo de las tarjetas",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_pad_d",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Relleno de las tarjetas en desktop",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_pad_m",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Relleno de las tarjetas en mobile",
      "default": 16
    },
    {
      "type": "header",
      "content": "Medio y alto"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Medio",
      "options": [
        {
          "value": "top",
          "label": "Arriba del texto"
        },
        {
          "value": "bottom",
          "label": "Abajo del texto"
        }
      ],
      "default": "top"
    },
    {
      "type": "checkbox",
      "id": "equal_height",
      "label": "Todas las tarjetas de la misma altura",
      "default": true
    },
    {
      "type": "select",
      "id": "valign",
      "label": "Contenido dentro de la tarjeta",
      "options": [
        {
          "value": "top",
          "label": "Arriba"
        },
        {
          "value": "center",
          "label": "Al medio"
        },
        {
          "value": "bottom",
          "label": "Abajo"
        },
        {
          "value": "spread",
          "label": "Repartido"
        }
      ],
      "default": "top",
      "info": "Con la misma altura: dónde queda el contenido sobrante."
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "range",
      "id": "title_size_d",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Títulos en desktop",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_size_m",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Títulos en mobile",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size_d",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Textos en desktop",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_m",
      "min": 8,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Textos en mobile",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Separación entre título y texto",
      "default": 8
    },
    {
      "type": "header",
      "content": "Ancho"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Usar todo el ancho de la página",
      "default": false
    },
    {
      "type": "header",
      "content": "Botón de agregar al carrito"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Texto del botón",
      "info": "Sin texto, el botón no aparece. En una ficha agrega ese producto con la variante y la cantidad elegidas."
    },
    {
      "type": "product",
      "id": "atc_product",
      "label": "Producto",
      "info": "Opcional. Si elegís uno, el botón agrega ése. Fuera de una ficha hace falta elegirlo."
    },
    {
      "type": "checkbox",
      "id": "atc_skip_cart",
      "label": "Ir directo al pago",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colores propios"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Usar colores propios",
      "default": false,
      "info": "Pisan a la combinación de colores elegida arriba."
    },
    {
      "type": "color",
      "id": "cc_bg",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "cc_bg_gradient",
      "label": "Degradé de fondo",
      "info": "Si cargás un degradé, reemplaza al color de fondo."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image",
      "label": "Imagen de fondo",
      "info": "Cubre todo el fondo y le gana al degradé."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image_mobile",
      "label": "Imagen de fondo en mobile",
      "info": "Vacía: usa la de desktop."
    },
    {
      "type": "color",
      "id": "cc_text",
      "label": "Texto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_accent",
      "label": "Acento",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "cc_btn_bg",
      "label": "Fondo del botón lleno",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_btn_text",
      "label": "Texto del botón lleno",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cc_outline",
      "label": "Botón de contorno y enlaces",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "header",
      "content": "Carrusel"
    },
    {
      "type": "select",
      "id": "car_type",
      "label": "Tipo",
      "options": [
        {
          "value": "classic",
          "label": "Clásico (se frena en los extremos)"
        },
        {
          "value": "loop",
          "label": "Infinito"
        }
      ],
      "default": "loop"
    },
    {
      "type": "select",
      "id": "car_drag",
      "label": "Arrastre con mouse o dedo",
      "options": [
        {
          "value": "off",
          "label": "Desactivado"
        },
        {
          "value": "on",
          "label": "Activado"
        }
      ],
      "default": "on"
    },
    {
      "type": "checkbox",
      "id": "car_autoplay",
      "label": "Pase automático",
      "default": false
    },
    {
      "type": "range",
      "id": "car_speed",
      "min": 1,
      "max": 15,
      "step": 0.5,
      "unit": "s",
      "label": "Velocidad del pase",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "car_arrows_scheme",
      "label": "Colores de las flechas",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "car_arrows_bare",
      "label": "Flechas transparentes",
      "default": false
    },
    {
      "type": "color",
      "id": "car_dots_color",
      "label": "Color de los puntos",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "header",
      "content": "Carrusel en desktop"
    },
    {
      "type": "checkbox",
      "id": "d_carousel",
      "label": "Mostrar como carrusel en desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "d_per_move",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Cuántos pasan por movimiento",
      "default": 1
    },
