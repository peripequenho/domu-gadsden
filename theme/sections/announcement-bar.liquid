{%- comment -%}
  Barra de anuncios (H03 y H04): anuncios en columnas o en carrusel (T04), con ícono, tamaños y
  disposición por dispositivo, visibilidad por producto (de la barra y de cada anuncio), cupón para
  copiar y redes sociales. Conserva las utilidades de Dawn (redes, país e idioma a los costados).
{%- endcomment -%}
{%- liquid
  assign s = section.settings

  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if s.enable_country_selector or s.enable_language_selector
    assign language_country_selector = true
  endif

  capture bar_visible
    render 'gad-product-visibility', list: s.hide_products, only: s.only_listed, product: product
  endcapture
-%}

{%- if bar_visible == 'true' or request.design_mode -%}
  {%- capture slides -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        capture block_visible
          render 'gad-product-visibility', list: b.hide_products, only: b.only_listed, product: product
        endcapture
        if block_visible != 'true'
          continue
        endif
        if block.type == 'social' and social_icons == false
          continue
        endif
      -%}
      <div
        class="gad-ann__item gad-ann__item--d-{{ b.layout_d }} gad-ann__item--m-{{ b.layout_m }} gad-ann__item--ad-{{ b.align_d }} gad-ann__item--am-{{ b.align_m }}"
        style="--fs-m: {{ b.size_m }}px; --fs-d: {{ b.size_d }}px; --ic-m: {{ b.icon_size_m }}px; --ic-d: {{ b.icon_size_d }}px;"
        {{ block.shopify_attributes }}
      >
        {%- case block.type -%}
          {%- when 'announcement' -%}
            {%- capture inner -%}
              {%- if b.icon != blank or b.icon_image != blank -%}
                {%- render 'gad-icon', name: b.icon, filled: b.icon_filled, image: b.icon_image, class: 'gad-ann__icon' -%}
              {%- endif -%}
              <span class="gad-ann__text">{{ b.text }}</span>
            {%- endcapture -%}
            {%- if b.link != blank -%}
              <a href="{{ b.link }}" class="gad-ann__inner gad-ann__link link link--text focus-inset">{{ inner }}</a>
            {%- else -%}
              <p class="gad-ann__inner">{{ inner }}</p>
            {%- endif -%}

          {%- when 'coupon' -%}
            <div class="gad-ann__inner">
              {%- if b.icon != blank or b.icon_image != blank -%}
                {%- render 'gad-icon', name: b.icon, filled: b.icon_filled, image: b.icon_image, class: 'gad-ann__icon' -%}
              {%- endif -%}
              {%- if b.text != blank -%}
                <span class="gad-ann__text">{{ b.text }}</span>
              {%- endif -%}
              <gad-copy class="gad-ann__coupon" data-code="{{ b.code | escape }}" data-copied="{{ b.copied | escape }}">
                <span class="gad-ann__code">{{ b.code | escape }}</span>
                <button type="button" class="gad-ann__copy" aria-label="{{ b.button | escape }} {{ b.code | escape }}">
                  <span data-gad-copy-label>{{ b.button | escape }}</span>
                </button>
                <span class="visually-hidden" role="status" data-gad-copy-status></span>
              </gad-copy>
            </div>

          {%- when 'social' -%}
            <div class="gad-ann__inner gad-ann__social">
              {%- render 'social-icons' -%}
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    assign count = slides | split: 'class="gad-ann__item ' | size | minus: 1
    assign d_cols = s.d_cols
    if d_cols == 0
      assign d_cols = count | at_least: 1
    endif
    assign bar_label = 'sections.announcements.announcement_bar' | t
    assign m_cols = s.m_cols
    if m_cols == 0
      assign m_cols = count | at_least: 1
    endif
  -%}

  {%- if social_icons and s.show_social -%}
    {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
  {%- else -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'social' -%}
        {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- render 'gad-colors', s: s, key: section.id -%}
  <div
    class="utility-bar gad-ann-bar {% render 'gad-scheme', s: s, key: section.id %}{% if s.show_line_separator %} utility-bar--bottom-border{% endif %}{% if s.separator %} gad-ann-bar--sep{% endif %}{% if language_country_selector %} header-localization{% endif %}{% if bar_visible != 'true' %} gad-ann-bar--hidden-here{% endif %}"
    style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
   {% if s.title_scale != blank and s.title_scale != '100' %} data-gad-hs="{{ s.title_scale }}"{% endif %}{% if s.text_scale != blank and s.text_scale != '100' %} data-gad-ts="{{ s.text_scale }}"{% endif %}
  >
    <div class="page-width utility-bar__grid{% if count > 0 and language_country_selector or s.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or s.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
      {%- if s.show_social and social_icons -%}
        {%- render 'social-icons' -%}
      {%- endif -%}
      {%- if count > 0 -%}
        <div class="announcement-bar gad-ann" role="region" aria-label="{{ 'sections.announcements.announcement_bar' | t }}">
          {%- render 'gad-carousel',
            s: s,
            key: section.id,
            slides: slides,
            d_per_view: d_cols,
            m_per_view: m_cols,
            gap_d: s.gap,
            gap_m: s.gap,
            label: bar_label
          -%}
        </div>
      {%- endif -%}
      <div class="localization-wrapper">
        {%- if s.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide">
            {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if s.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide">
            {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
