    },
    {
      "type": "checkbox",
      "id": "ok_icon_filled",
      "label": "Ícono relleno",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "ok_icon_image",
      "label": "Ícono propio (imagen)"
