{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign s = section.settings
  assign form_id = 'ContactForm-' | append: section.id
  assign contact_form_class = 'isolate gad-cf__form'
  if settings.animations_reveal_on_scroll
    assign contact_form_class = 'isolate gad-cf__form scroll-trigger animate--slide-in'
  endif
  assign has_email = false
  for block in section.blocks
    if block.type == 'fields'
      if block.settings.f1_on and block.settings.f1_type == 'email'
        assign has_email = true
      endif
      if block.settings.f2_on and block.settings.f2_type == 'email'
        assign has_email = true
      endif
    endif
  endfor
  assign id_name = form_id | append: '-name'
  assign id_email = form_id | append: '-email'
  assign id_phone = form_id | append: '-phone'
  assign id_body = form_id | append: '-body'
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="{% render 'gad-scheme', s: s, key: section.id %}"
  style="--ok-fg: {{ s.ok_text }}; --ok-bg: {{ s.ok_bg }}; --ok-r: {{ s.ok_radius }}px; --ok-bw: {{ s.ok_border }}px; --ok-bc: {{ s.ok_border_color }}; --err-fg: {{ s.err_text }}; --err-bg: {{ s.err_bg }}; --err-r: {{ s.err_radius }}px; --err-bw: {{ s.err_border }}px; --err-bc: {{ s.err_border_color }};"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2
        class="title title-wrapper--no-top-margin inline-richtext gad-hl {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if s.heading_accent != blank %}
          style="--gad-hl: {{ s.heading_accent }};"
        {% endif %}
      >
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    <gad-contact-form>
      {%- form 'contact', id: form_id, class: contact_form_class -%}
        {%- liquid
          assign value_name = form.name | default: customer.name
          assign value_email = form.email | default: customer.email
          assign value_phone = form.phone | default: customer.phone
        -%}
        {%- if form.posted_successfully? -%}
          <div class="gad-form-msg gad-form-msg--ok" role="status" tabindex="-1" autofocus>
            {%- render 'gad-icon', name: s.ok_icon, filled: s.ok_icon_filled, image: s.ok_icon_image, class: 'gad-form-msg__icon' -%}
            <p class="gad-form-msg__text">{{ 'templates.contact.form.post_success' | t }}</p>
          </div>
        {%- elsif form.errors -%}
          <div class="gad-form-msg gad-form-msg--err" role="alert" tabindex="-1" autofocus>
            {%- render 'gad-icon', name: s.err_icon, filled: s.err_icon_filled, image: s.err_icon_image, class: 'gad-form-msg__icon' -%}
            <div class="gad-form-msg__text">
              <p>{{ 'templates.contact.form.error_heading' | t }}</p>
              <ul class="list-unstyled" role="list">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        {%- if section.blocks.size == 0 -%}
          <div class="gad-cf__row gad-cf__row--2">
            {%- render 'gad-contact-field', type: 'name', id: id_name, value: value_name -%}
            {%- render 'gad-contact-field', type: 'email', id: id_email, value: value_email -%}
          </div>
          <div class="gad-cf__row">
            {%- render 'gad-contact-field', type: 'phone', id: id_phone, value: value_phone -%}
          </div>
          <div class="gad-cf__row">
            {%- render 'gad-contact-field', type: 'comment', id: id_body, value: form.body -%}
          </div>
        {%- else -%}
          {%- unless has_email -%}
            <div class="gad-cf__row">
              {%- render 'gad-contact-field', type: 'email', id: id_email, value: value_email -%}
            </div>
          {%- endunless -%}
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- case block.type -%}
              {%- when 'fields' -%}
                {%- liquid
                  assign n = 0
                  if b.f1_on
                    assign n = n | plus: 1
                  endif
                  if b.f2_on
                    assign n = n | plus: 1
                  endif
                -%}
                {%- if n > 0 -%}
                  <div class="gad-cf__row gad-cf__row--{{ n }}" {{ block.shopify_attributes }}>
                    {%- for i in (1..2) -%}
                      {%- liquid
                        assign k = 'f' | append: i | append: '_'
                        assign k_on = k | append: 'on'
                        assign k_type = k | append: 'type'
                        assign k_label = k | append: 'label'
                        assign k_req = k | append: 'required'
                        assign k_err = k | append: 'error'
                        unless b[k_on]
                          continue
                        endunless
                        assign ftype = b[k_type]
                        case ftype
                          when 'name'
                            assign fvalue = value_name
                          when 'email'
                            assign fvalue = value_email
                          when 'phone'
                            assign fvalue = value_phone
                          else
                            assign fvalue = ''
                        endcase
                        assign fid = form_id | append: '-' | append: block.id | append: '-' | append: i
                      -%}
                      {%- render 'gad-contact-field', type: ftype, id: fid, label: b[k_label], required: b[k_req], error: b[k_err], value: fvalue -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- when 'textarea' -%}
                {%- liquid
                  assign fid = form_id | append: '-' | append: block.id
                  assign ftype = 'comment'
                  if b.kind == 'custom'
                    assign ftype = 'textarea'
                  endif
                -%}
                <div class="gad-cf__row" {{ block.shopify_attributes }}>
                  {%- render 'gad-contact-field', type: ftype, id: fid, label: b.label, required: b.required, error: b.error, maxlength: b.maxlength, value: form.body -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}
        <div class="contact__button{% if s.button_full_width %} gad-cf__button--full{% endif %}">
          <button type="submit" class="button">
            {%- if s.button_label != blank -%}{{ s.button_label | escape }}{%- else -%}{{ 'templates.contact.form.send' | t }}{%- endif -%}
          </button>
        </div>
      {%- endform -%}
    </gad-contact-form>
  </div>
</div>

{% schema %}
