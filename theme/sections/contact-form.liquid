    },
    {
      "type": "color",
      "id": "cc_btn_text",
      "label": "Texto del botón lleno",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cc_outline",
      "label": "Botón de contorno y enlaces",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Mensaje de éxito"
    },
    {
      "type": "text",
      "id": "ok_icon",
      "label": "Ícono",
